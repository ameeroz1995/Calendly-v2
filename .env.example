# Calendly v2 — Environment Variables
# Copy this file to .env (or .env.local for Vite)
# Never commit real secrets.

# ── Firebase Client-side (Vite prefix) ──
VITE_FIREBASE_API_KEY=AIzaSy-xxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=calendly-v2.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://calendly-v2-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=calendly-v2

# ── OAuth Providers (Client IDs — safe to expose) ──
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Cloud Functions (server-side only — NEVER exposed to client) ──

# AES-256 encryption key for OAuth tokens (64 hex chars = 32 bytes)
OAUTH_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid API key for email notifications
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From email address for notifications
FROM_EMAIL=noreply@calendly-v2.com

# Webhook HMAC signing secret
WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth client secret
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Microsoft OAuth client secret
MICROSOFT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Application URL (for OAuth redirect URIs)
APP_URL=http://localhost:5000

# ── Twilio (SMS notifications — Phase 7+) ──
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890
